rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────────
    // Les clients en production (v1.1.3) DOIVENT continuer à fonctionner :
    // chaque règle est couverte par firebase-tests/tests/firestore.legit.test.mjs
    // (flux légitimes) et firestore.attacks.test.mjs (attaques refusées).

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function memberPath(groupId, userId) {
      return /databases/$(database)/documents/groups/$(groupId)/members/$(userId);
    }

    // Appartenance : existence du doc membre (état avant la requête).
    function isGroupMember(groupId) {
      return isSignedIn() && exists(memberPath(groupId, uid()));
    }

    function isGroupOwner(groupId) {
      return isSignedIn() && get(groupPath(groupId)).data.createdBy == uid();
    }

    // Clés modifiées par une mise à jour (ajoutées, retirées ou changées).
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── App config (version check) ──────────────────────────────────────────
    // Public read so the update check works before authentication.
    // Write is restricted to Admin SDK only (no client write allowed).
    match /config/{document} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Users (FCM tokens, photo de profil) ─────────────────────────────────
    match /users/{userId} {
      allow read, write: if isSignedIn() && uid() == userId;
    }

    // ── Invite codes ────────────────────────────────────────────────────────
    // get : résolution d'un code saisi ou d'un lien (avant adhésion).
    // list : INTERDIT (sinon énumération de tous les groupes).
    // create / delete : réservé aux membres du groupe visé. existsAfter couvre
    // le batch de création de groupe (groupe + membre + code dans le même commit).
    // update : interdit (une collision de code fait échouer la création).
    match /invite_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'groupName', 'groupEmoji'])
        && request.resource.data.groupId is string
        && existsAfter(memberPath(request.resource.data.groupId, uid()));
      allow delete: if isSignedIn()
        && exists(memberPath(resource.data.groupId, uid()));
    }

    // ── Groups ──────────────────────────────────────────────────────────────
    match /groups/{groupId} {

      function addedMemberIds() {
        return request.resource.data.memberIds.toSet()
          .difference(resource.data.memberIds.toSet());
      }

      function removedMemberIds() {
        return resource.data.memberIds.toSet()
          .difference(request.resource.data.memberIds.toSet());
      }

      function validNameAndDescription() {
        return (!('name' in changedKeys())
            || (request.resource.data.name is string
                && request.resource.data.name.size() >= 1
                && request.resource.data.name.size() <= 30))
          && (!('description' in changedKeys())
            || (request.resource.data.description == null
                || (request.resource.data.description is string
                    && request.resource.data.description.size() <= 150)));
      }

      // Un membre ne peut que se retirer lui-même ; le propriétaire peut retirer
      // les autres. Personne n'ajoute un tiers.
      function validMemberIdsChangeByMember() {
        return !('memberIds' in changedKeys())
          || (request.resource.data.memberIds is list
              && addedMemberIds().size() == 0
              && (removedMemberIds() == [uid()].toSet()
                  || (resource.data.createdBy == uid()
                      && !(uid() in removedMemberIds()))));
      }

      // Seul le propriétaire transfère la propriété, et seulement à un membre.
      function validOwnershipChange() {
        return !('createdBy' in changedKeys())
          || (resource.data.createdBy == uid()
              && request.resource.data.createdBy in request.resource.data.memberIds);
      }

      // Adhésion (flux joinGroup v1.1.3) : un non-membre s'ajoute lui-même,
      // sans rien modifier d'autre.
      // ⚠️ Résiduel jusqu'à S3 (callable joinGroupByCode) : la preuve du code
      // d'invitation n'est pas vérifiable ici (cf. docs/refactor/PLAN.md).
      // Cas toléré : déjà dans memberIds sans doc membre (état incohérent
      // hérité) → l'arrayUnion est un no-op, la v1.1.3 recrée alors le doc membre.
      function isSelfJoin() {
        return isSignedIn()
          && changedKeys().hasOnly(['memberIds'])
          && request.resource.data.memberIds is list
          && removedMemberIds().size() == 0
          && (addedMemberIds() == [uid()].toSet()
              || (addedMemberIds().size() == 0
                  && uid() in resource.data.memberIds));
      }

      // Read: user must be a member
      allow read: if isSignedIn() && uid() in resource.data.memberIds;

      // Create: user creates a group where they are owner and first member
      allow create: if isSignedIn()
        && uid() in request.resource.data.memberIds
        && request.resource.data.createdBy == uid()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 30
        && (request.resource.data.description == null
            || (request.resource.data.description is string
                && request.resource.data.description.size() <= 150));

      allow update: if validNameAndDescription()
        && ((isGroupMember(groupId)
              && validMemberIdsChangeByMember()
              && validOwnershipChange())
            || isSelfJoin());

      // Delete: owner only
      allow delete: if isGroupOwner(groupId);

      // ── Members ───────────────────────────────────────────────────────────
      match /members/{memberId} {

        // Rôle accepté à l'écriture : 'member', ou 'owner' seulement pour le
        // propriétaire du groupe (createGroup : groupe créé dans le même batch).
        function validRoleOnCreate() {
          return request.resource.data.role == 'member'
            || (request.resource.data.role == 'owner'
                && getAfter(groupPath(groupId)).data.createdBy == uid());
        }

        allow read: if isGroupMember(groupId);

        // create : uniquement son propre doc, et seulement si l'on figure dans
        // memberIds après le batch (createGroup / joinGroup).
        allow create: if isSignedIn()
          && uid() == memberId
          && request.resource.data.uid == memberId
          && uid() in getAfter(groupPath(groupId)).data.memberIds
          && validRoleOnCreate();

        // update : son propre doc sans auto-promotion (le rôle ne peut que
        // redevenir 'member'), ou n'importe quel doc par le propriétaire.
        allow update: if isGroupMember(groupId)
          && ((uid() == memberId
                && (!('role' in changedKeys())
                    || request.resource.data.role == 'member'))
              || isGroupOwner(groupId));

        // delete : quitter (sauf le propriétaire, qui doit d'abord transférer)
        // ou retrait d'un autre membre par le propriétaire.
        allow delete: if isSignedIn()
          && ((uid() == memberId
                && get(groupPath(groupId)).data.createdBy != uid())
              || (memberId != uid() && isGroupOwner(groupId)));
      }

      // ── Messages ──────────────────────────────────────────────────────────
      match /messages/{messageId} {

        function validNewMessage() {
          let data = request.resource.data;
          return data.senderId == uid()
            && data.groupId == groupId
            && data.type in ['text', 'system', 'image', 'file', 'poll', 'audio']
            && data.content is string
            && data.timestamp is timestamp;
        }

        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && validNewMessage();
        // L'expéditeur édite son message / sondage ; tout membre réagit et vote
        // (votes = reactions).
        allow update: if isGroupMember(groupId)
          && ((resource.data.senderId == uid()
                && changedKeys().hasOnly(['content', 'editedAt', 'reactions']))
              || changedKeys().hasOnly(['reactions']));
        allow delete: if isGroupMember(groupId)
          && resource.data.senderId == uid();
      }

      // ── Typing indicators ─────────────────────────────────────────────────
      match /typing/{typingUserId} {
        allow read:  if isGroupMember(groupId);
        allow write: if isSignedIn() && uid() == typingUserId;
      }

      // ── Validation commune des documents métier ───────────────────────────
      // Champs que l'app caste strictement à la lecture : un document invalide
      // ferait planter l'onglet de tous les membres (BUGS_FOUND D1).
      function createdBySelfInGroup() {
        return request.resource.data.createdBy == uid()
          && request.resource.data.groupId == groupId;
      }

      function ownershipUnchanged() {
        return request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.groupId == resource.data.groupId;
      }

      // ── Expenses ──────────────────────────────────────────────────────────
      match /expenses/{expenseId} {
        function validExpense() {
          let data = request.resource.data;
          return data.title is string
            && data.amount is number
            && data.paidBy is string
            && data.splitWith is list
            && data.date is timestamp
            && data.createdBy is string
            && data.createdAt is timestamp;
        }

        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && createdBySelfInGroup() && validExpense();
        allow update: if isGroupMember(groupId) && ownershipUnchanged() && validExpense();
        allow delete: if isGroupMember(groupId);
      }

      // ── Events (calendar) ─────────────────────────────────────────────────
      match /events/{eventId} {
        function validEvent() {
          let data = request.resource.data;
          return data.title is string
            && data.startDate is timestamp
            && data.createdBy is string
            && data.createdAt is timestamp;
        }

        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && createdBySelfInGroup() && validEvent();
        allow update: if isGroupMember(groupId) && ownershipUnchanged() && validEvent();
        allow delete: if isGroupMember(groupId);
      }

      // ── Notes ─────────────────────────────────────────────────────────────
      match /notes/{noteId} {
        function validNote() {
          let data = request.resource.data;
          return data.title is string
            && data.content is string
            && data.createdBy is string
            && data.createdAt is timestamp
            && data.updatedAt is timestamp;
        }

        allow read: if isGroupMember(groupId);
        allow create: if isGroupMember(groupId) && createdBySelfInGroup() && validNote();
        allow update: if isGroupMember(groupId) && ownershipUnchanged() && validNote();
        allow delete: if isGroupMember(groupId);
      }

      // ── Tab settings ──────────────────────────────────────────────────────
      match /config/{configId} {
        allow read:  if isGroupMember(groupId);
        allow write: if isGroupMember(groupId) && configId == 'tabSettings';
      }
    }
  }
}
